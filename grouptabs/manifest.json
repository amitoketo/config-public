{
  "manifest_version": 3,
  "name": "Tab Grouper",
  "version": "1.0",
  "background": {"service_worker": "background.js", "type": "module"},
  "permissions": ["tabs", "tabGroups", "storage", "contextMenus"],
  "host_permissions": ["https://cdn.jsdelivr.net/*"],
  "action": {"default_title": "Group Tabs"}
}